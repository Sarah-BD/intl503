# --- Build artifacts (regenerated by `quarto render`) ---
_site/
_freeze/
.quarto/
*_files/
*_cache/

# --- Private / do NOT push to a public repo ---
# NOTE: inline "# comment" text on these lines used to be parsed as part of
# the pattern itself (gitignore only treats a line as a comment if the line
# STARTS with #), which meant none of the five rules below ever actually
# matched anything. Comments now live on their own line above each pattern.

# copyrighted textbook chapter PDFs + article PDFs (distributed via Canvas only)
readings/

# publisher test bank (now lives under exams/test-bank/ too — bare pattern
# below matches at any depth, so this still catches it there)
test-bank/

# lecture-prep notes, including old materials from prior courses
teaching-notes/

# exam/quiz materials with answer keys (docx files + test-bank copy)
exams/

# superseded drafts, old slide versions, planning logs
_archive/

# --- OS / editor cruft ---
.DS_Store
.Rhistory
.Rproj.user/

/.quarto/
